# Preserve measured artifact/source bytes; allow ordinary docs to use native endings.
* text=auto whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/src/** -text
/results/** -text
/report/** -text
/README.md -text
# Matplotlib emits trailing spaces inside SVG path attributes (also embedded in HTML).
/results/figs/*.svg whitespace=-blank-at-eol,cr-at-eol
/report/index.html whitespace=-blank-at-eol,cr-at-eol
